# WattWise Backend Environment Configuration (Render / Local)
PORT=4000
NODE_ENV=production
JWT_SECRET=wattwise_tpds3_production_secret
MQTT_URL=mqtt://localhost:1883

# Optional: Remote or Local MySQL DB credentials
# If omitted or unavailable, backend automatically uses the built-in in-memory fallback store
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=wattwise
